rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas de seguridad para AniCS Cloud Sync:
    // Cada usuario autenticado solo puede leer y escribir sus propios datos (perfiles, historial, favoritos, settings)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
