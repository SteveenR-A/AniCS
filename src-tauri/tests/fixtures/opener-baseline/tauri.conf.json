{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniCS",
  "version": "0.3.11",
  "identifier": "com.anics.app",
  "build": {
    "frontendDist": "../../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AniCS",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "capabilities": [
        {
          "identifier": "original-opener",
          "windows": [
            "main"
          ],
          "permissions": [
            "opener:default",
            "opener:allow-open-path"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../../src-tauri/icons/icon.ico"
    ]
  }
}
